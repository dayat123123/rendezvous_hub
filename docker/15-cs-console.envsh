#!/bin/sh

cs_fail() {
    echo "cs-console: $1" >&2
    exit 1
}

mkdir -p /tmp/runtime /tmp/nginx/conf.d || cs_fail "cannot write to /tmp"

if [ -n "${SUPABASE_ANON_KEY_FILE:-}" ]; then
    [ -r "$SUPABASE_ANON_KEY_FILE" ] || cs_fail "SUPABASE_ANON_KEY_FILE is not readable"
    SUPABASE_ANON_KEY=$(tr -d '\r\n' < "$SUPABASE_ANON_KEY_FILE")
fi

cs_url=${SUPABASE_URL:-}
cs_url=${cs_url%/}
printf '%s' "$cs_url" | grep -Eq '^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?$' \
    || cs_fail "SUPABASE_URL must be an http(s)://host[:port] origin without a path"
cs_public=${PUBLIC_API_URL:-$cs_url}
cs_public=${cs_public%/}
printf '%s' "$cs_public" | grep -Eq '^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?$' \
    || cs_fail "PUBLIC_API_URL must be an http(s)://host[:port] origin without a path"
printf '%s' "${SUPABASE_ANON_KEY:-}" | grep -Eq '^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$' \
    || cs_fail "SUPABASE_ANON_KEY is empty or not a JWT"

cs_env=${APP_ENV:-production}
case "$cs_env" in
    development | staging | production) ;;
    *) cs_fail "APP_ENV must be development, staging, or production" ;;
esac

printf 'window.__CS_CONSOLE_ENV__ = Object.freeze({"SUPABASE_URL":"%s","SUPABASE_ANON_KEY":"%s","APP_ENV":"%s","PUBLIC_API_URL":"%s"});\n' \
    "$cs_url" "$SUPABASE_ANON_KEY" "$cs_env" "$cs_public" > /tmp/runtime/env.js || cs_fail "failed to write env.js"

CS_API_ORIGIN=$cs_url
CS_API_WS_ORIGIN=$(printf '%s' "$cs_url" | sed 's#^http#ws#')
export CS_API_ORIGIN CS_API_WS_ORIGIN

unset SUPABASE_ANON_KEY cs_url cs_env cs_public
echo "cs-console: env.js ready for $CS_API_ORIGIN"
